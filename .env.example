# Copy this file to .env and fill in your own key. Never commit .env.
#
# Any OpenAI-compatible endpoint works. Free options:
#   Groq   https://console.groq.com/keys   (LLM_BASE_URL=https://api.groq.com/openai/v1)
#   Gemini https://aistudio.google.com/apikey (LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai)
#   Ollama local, no key needed (LLM_BASE_URL=http://localhost:11434/v1)
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
# One model, or several separated by commas (the next is used when a daily free quota runs out).
LLM_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# Match your provider's free-tier limits (Groq: 8000 tokens per minute).
LLM_TPM_LIMIT=8000
# LLM_RPM_LIMIT=8   # for providers that cap requests per minute instead (e.g. Gemini free tier)
